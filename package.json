{
  "name": "opener",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ext": "pnpm --filter @opener/extension dev",
    "dev:web": "pnpm --filter @opener/web dev",
    "build": "pnpm -r build",
    "compile": "pnpm -r compile",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @opener/extension test:e2e"
  },
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^5.0.0"
  }
}
