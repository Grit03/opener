{
  "name": "opener",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ext": "pnpm --filter @opener/extension dev",
    "dev:web": "pnpm --filter @opener/web dev",
    "build": "pnpm -r build",
    "compile": "pnpm -r compile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @opener/extension test:e2e"
  },
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "catalog:",
    "lefthook": "^2.1.12",
    "prettier": "3.9.6",
    "vitest": "^5.0.0"
  }
}
