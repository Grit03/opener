    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^5.0.0",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "serve": "^14.2.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.69.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
